{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sidemic",
  "version": "0.1.0",
  "identifier": "com.truephonelink.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../../../phone-server/out/tpl-server.jar": "phone/tpl-server.jar",
      "../../../phone-server/out/libtpl_voice_jni.so": "phone/libtpl_voice_jni.so",
      "icons/tray.png": "tray.png"
    },
    "copyright": "Copyright 2026 Ethan (Sidemic contributors)",
    "license": "Apache-2.0",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
